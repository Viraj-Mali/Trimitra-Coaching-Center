# Environment Variables — Trimitra Coaching Centre

# ─── DATABASE ─────────────────────────────────────────────────────────────────
DATABASE_URL="file:./dev.db"

# ─── AUTH ─────────────────────────────────────────────────────────────────────
JWT_SECRET="CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING_IN_PRODUCTION"

# ─── APP ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Trimitra Coaching Centre"

# ─── ADMIN SETUP ──────────────────────────────────────────────────────────────
# Required for `npm run seed:admin` to create the initial admin user.
ADMIN_MOBILE=""
ADMIN_PASSWORD=""
ADMIN_NAME=""
